# ====================================================
# Placement Hub - Environment Variables Template
# Copy this file to .env and configure your secrets
# DO NOT commit .env to version control
# ====================================================

# Server Port
PORT=5000

# Environment mode: 'development' or 'production'
# In production, SECRET_KEY, JWT_SECRET_KEY, and ADMIN_ACCESS_CODE are strictly required.
FLASK_ENV=production

# Application Secret Key (Provide a unique 64-character secret for production)
SECRET_KEY=your_flask_secret_key_here

# JWT Signing Secret Key (Provide a unique 64-character secret for token signing)
JWT_SECRET_KEY=your_jwt_signing_secret_here

# Shared Administrator Access Code for verification during Admin Signup
ADMIN_ACCESS_CODE=your_admin_signup_access_code_here

# Initial Primary Administrator Password (Required ONLY for first-time production database initialization)
INITIAL_ADMIN_PASSWORD=your_secure_initial_admin_password_here

# Primary Administrator Email & ID (optional overrides during initial provisioning)
# ADMIN_EMAIL=faculty.placement@mlrit.ac.in
# ADMIN_ID=ADM101

# SQLite Database Location (defaults to instance/placementhub.db if not specified)
# DATABASE_URL=sqlite:///instance/placementhub.db
